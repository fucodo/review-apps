# --- Domains ------------------------------------------------------------
# MR environments are served as mr-<iid>.<BASE_DOMAIN>
BASE_DOMAIN=tests.example.org
DASHBOARD_HOST=reviews.tests.example.org
# Only used with AUTH_MODE=oidc
AUTH_HOST=auth.tests.example.org

# --- Dashboard branding (optional) --------------------------------------
# Logo in the dashboard header, one of:
#   https://example.org/logo.svg
#   "data:image/png;base64,iVBORw0…"   (quotes required because of the ";")
#   iVBORw0…                           (plain base64, e.g. from: base64 -w0 logo.png)
DASHBOARD_LOGO=
# Where the logo links to (http/https), e.g. your company or GitLab
DASHBOARD_LOGO_LINK=

# --- Let's Encrypt (TLS-ALPN challenge, no DNS API needed) ---------------
ACME_EMAIL=ops@example.org
# Use the staging CA while testing to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- Access protection for MR environments and dashboard ----------------
# none  = no login (only noindex header)
# basic = HTTP basic auth, users managed with ./install.sh add-user <name>
# oidc  = GitLab login via oauth2-proxy
AUTH_MODE=basic

# --- GitLab OIDC (AUTH_MODE=oidc) ----------------------------------------
# GitLab application: redirect URI https://<AUTH_HOST>/oauth2/callback,
# confidential, scopes: openid email profile
GITLAB_URL=https://gitlab.example.org
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Comma-separated GitLab groups whose members get access
GITLAB_GROUPS=
# Generated by install.sh if empty
OAUTH2_COOKIE_SECRET=

# --- Versions -----------------------------------------------------------
TRAEFIK_VERSION=v3
# Pin a current v7.x release
OAUTH2_PROXY_VERSION=latest
TRAEFIK_LOG_LEVEL=INFO
